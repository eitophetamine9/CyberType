@page "/"
@inject GameSessionState GameState
@inject NavigationManager Navigation

<PageTitle>BRIEFING ROOM // CyberType Terminal OS</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col justify-between p-6 md:p-12 relative overflow-hidden font-mono select-none cursor-default">
    <!-- Ambient Structural Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#33415512_1px,transparent_1px),linear-gradient(to_bottom,#33415512_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] pointer-events-none select-none"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none select-none"></div>

    <!-- Header Terminal Banner -->
    <header class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between border-b border-slate-800/80 pb-6 gap-4 select-none">
        <div class="flex items-center gap-4">
            <div class="w-11 h-11 rounded-lg bg-slate-900 border border-slate-700/80 text-cyan-400 flex items-center justify-center font-bold text-lg shadow-sm">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z"/>
                </svg>
            </div>
            <div>
                <div class="flex items-center gap-2.5">
                    <h1 class="text-xl font-bold tracking-tight text-white uppercase select-none">CYBERTYPE // COMMAND CONSOLE</h1>
                    <span class="px-2 py-0.5 rounded text-[10px] bg-cyan-950/80 text-cyan-300 border border-cyan-800/80 font-bold tracking-wider select-none">OPERATIONAL</span>
                </div>
                <p class="text-xs text-slate-400 tracking-wider select-none">DEFENSE GRID TERMINAL // PURE C# WEBASSEMBLY ENGINE</p>
            </div>
        </div>

        <!-- Navigation & Profile Access -->
        <div class="flex items-center gap-3 text-xs select-none">
            <button @onclick='() => Navigation.NavigateTo("/profile")'
                    class="btn-tactical-outline cursor-pointer px-3.5 py-2 rounded text-slate-300 flex items-center gap-2">
                <svg class="w-3.5 h-3.5 fill-current text-cyan-400" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
                <span>Operator Dossier</span>
                @if (GameState.BestWpm > 0)
                {
                    <span class="px-1.5 py-0.5 rounded bg-slate-950 text-[10px] text-cyan-400 font-bold border border-slate-800">
                        @GameState.BestWpm WPM
                    </span>
                }
            </button>
        </div>
    </header>

    <!-- Main Dashboard Grid -->
    <main class="relative z-10 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8 items-start select-none">
        
        <!-- Mission Intel & Configurations -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Mission Briefing Card -->
            <div class="rounded-xl bg-slate-900/70 border border-slate-800 p-8 shadow-xl space-y-6 select-none">
                <div class="space-y-2 select-none">
                    <span class="text-[11px] uppercase tracking-widest text-cyan-400 font-bold flex items-center gap-2 select-none">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                        MISSION BRIEFING
                    </span>
                    <h2 class="text-2xl font-bold text-white tracking-tight select-none">
                        Defend The Base Perimeter
                    </h2>
                    <p class="text-xs text-slate-300 leading-relaxed select-none">
                        Hostile lexical vessels are descending toward your defense perimeter. Lock onto hostiles by striking the initial letter, neutralize targets with rapid keystrokes, and synthesize upgrade modules between combat sectors.
                    </p>
                </div>

                <!-- 1. LEXICON MODE SELECTOR (Syntax, English, Mixed) -->
                <div class="space-y-2 select-none">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider font-bold text-slate-300">
                            01 // Lexicon Vocabulary Source
                        </span>
                        <span class="text-[11px] text-slate-500">Target Word Stream</span>
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div @onclick="() => SelectLexicon(LexiconMode.Mixed)"
                             class="p-3.5 rounded cursor-pointer transition-all duration-150 border flex flex-col items-center justify-center text-center space-y-1 select-none
                                    @(GameState.SelectedLexiconMode == LexiconMode.Mixed 
                                        ? "bg-slate-950 border-cyan-400 text-white shadow-[0_0_12px_rgba(6,182,212,0.25)]" 
                                        : "bg-slate-950/60 border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200")">
                            <span class="text-xs font-bold text-cyan-300">MIXED HYBRID</span>
                            <span class="text-[10px] text-slate-500">Syntax + English</span>
                        </div>

                        <div @onclick="() => SelectLexicon(LexiconMode.Syntax)"
                             class="p-3.5 rounded cursor-pointer transition-all duration-150 border flex flex-col items-center justify-center text-center space-y-1 select-none
                                    @(GameState.SelectedLexiconMode == LexiconMode.Syntax 
                                        ? "bg-slate-950 border-cyan-400 text-white shadow-[0_0_12px_rgba(6,182,212,0.25)]" 
                                        : "bg-slate-950/60 border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200")">
                            <span class="text-xs font-bold text-cyan-300">CODE SYNTAX</span>
                            <span class="text-[10px] text-slate-500">C# Keywords & Syntax</span>
                        </div>

                        <div @onclick="() => SelectLexicon(LexiconMode.English)"
                             class="p-3.5 rounded cursor-pointer transition-all duration-150 border flex flex-col items-center justify-center text-center space-y-1 select-none
                                    @(GameState.SelectedLexiconMode == LexiconMode.English 
                                        ? "bg-slate-950 border-cyan-400 text-white shadow-[0_0_12px_rgba(6,182,212,0.25)]" 
                                        : "bg-slate-950/60 border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200")">
                            <span class="text-xs font-bold text-cyan-300">REGULAR WORDS</span>
                            <span class="text-[10px] text-slate-500">English Vocabulary</span>
                        </div>
                    </div>
                </div>

                <!-- 2. DIFFICULTY SELECTION (Easy, Medium, Hard) -->
                <div class="space-y-2 select-none">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider font-bold text-slate-300">
                            02 // Combat Difficulty Tier
                        </span>
                        <span class="text-[11px] text-slate-500">Velocity & Multipliers</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Easy Option -->
                        <div @onclick="() => SelectDifficulty(GameDifficulty.Easy)"
                             class="p-4 rounded cursor-pointer transition-all duration-150 border flex flex-col justify-between space-y-2 select-none
                                    @(GameState.SelectedDifficulty == GameDifficulty.Easy 
                                        ? "bg-slate-950 border-emerald-400 text-white shadow-[0_0_12px_rgba(16,185,129,0.25)]" 
                                        : "bg-slate-950/60 border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200")">
                            <div class="flex justify-between items-center select-none">
                                <span class="font-bold text-xs text-emerald-400 uppercase tracking-wider">RECRUIT // EASY</span>
                            </div>
                            <div class="text-[11px] text-slate-400 space-y-1 select-none">
                                <div>Length: <strong>3-5 Letters</strong></div>
                                <div>Speed: <strong>0.65x Velocity</strong></div>
                                <div>Shield: <strong>+1 Typo Buffer</strong></div>
                            </div>
                        </div>

                        <!-- Medium Option -->
                        <div @onclick="() => SelectDifficulty(GameDifficulty.Medium)"
                             class="p-4 rounded cursor-pointer transition-all duration-150 border flex flex-col justify-between space-y-2 select-none
                                    @(GameState.SelectedDifficulty == GameDifficulty.Medium 
                                        ? "bg-slate-950 border-amber-400 text-white shadow-[0_0_12px_rgba(245,158,11,0.25)]" 
                                        : "bg-slate-950/60 border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200")">
                            <div class="flex justify-between items-center select-none">
                                <span class="font-bold text-xs text-amber-400 uppercase tracking-wider">OPERATOR // MEDIUM</span>
                            </div>
                            <div class="text-[11px] text-slate-400 space-y-1 select-none">
                                <div>Length: <strong>5-8 Letters</strong></div>
                                <div>Speed: <strong>1.0x Velocity</strong></div>
                                <div>Score: <strong>1.4x Multiplier</strong></div>
                            </div>
                        </div>

                        <!-- Hard Option -->
                        <div @onclick="() => SelectDifficulty(GameDifficulty.Hard)"
                             class="p-4 rounded cursor-pointer transition-all duration-150 border flex flex-col justify-between space-y-2 select-none
                                    @(GameState.SelectedDifficulty == GameDifficulty.Hard 
                                        ? "bg-slate-950 border-rose-400 text-white shadow-[0_0_12px_rgba(244,63,94,0.25)]" 
                                        : "bg-slate-950/60 border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200")">
                            <div class="flex justify-between items-center select-none">
                                <span class="font-bold text-xs text-rose-400 uppercase tracking-wider">ELITE // HARD</span>
                            </div>
                            <div class="text-[11px] text-slate-400 space-y-1 select-none">
                                <div>Length: <strong>8-14 Letters</strong></div>
                                <div>Speed: <strong>1.4x Velocity</strong></div>
                                <div>Score: <strong>2.0x Multiplier</strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Deploy Button Action -->
                <div class="pt-2 flex flex-col sm:flex-row items-center gap-4 select-none">
                    <button @onclick="StartNewRun"
                            class="btn-tactical-primary cursor-pointer w-full sm:w-auto px-8 py-3.5 rounded text-xs tracking-widest uppercase flex items-center justify-center gap-2 select-none">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        COMMENCE RUN // ENGAGE [@GameState.SelectedDifficulty.ToString().ToUpper()]
                    </button>
                    
                    <span class="text-xs text-slate-500 font-mono select-none">
                        Engage defense grid with selected parameters
                    </span>
                </div>
            </div>

            <!-- Terminal Diagnostics Log -->
            <div class="rounded-xl bg-slate-900/60 border border-slate-800 p-5 space-y-2 font-mono text-xs select-none">
                <div class="flex items-center justify-between text-slate-500 border-b border-slate-800/80 pb-2">
                    <span class="text-cyan-400 font-semibold">> SYSTEM READY</span>
                    <span class="text-slate-400">@GameState.SelectedLexiconMode.ToString().ToUpper() // @GameState.SelectedDifficulty.ToString().ToUpper()</span>
                </div>
                <div class="space-y-1 text-slate-400 leading-relaxed select-none text-[11px]">
                    <p class="text-emerald-400">• C# WebAssembly runtime loop ready at 60 FPS.</p>
                    <p class="text-cyan-300">• Active vocabulary: @GameState.GetActiveDictionary().Count words indexed.</p>
                    <p class="text-slate-400">• Telemetry tracking accuracy, WPM, and wave records.</p>
                </div>
            </div>
        </div>

        <!-- Terminal System Status & History Sidebar -->
        <div class="space-y-6 select-none">
            <!-- Operator Quick Telemetry Card -->
            <div class="rounded-xl bg-slate-900/70 border border-slate-800 p-6 shadow-md space-y-4 select-none">
                <div class="flex justify-between items-center select-none">
                    <h3 class="text-xs font-bold text-slate-200 tracking-wider uppercase">
                        Operator Benchmarks
                    </h3>
                    <a href="profile" class="text-xs text-cyan-400 hover:text-cyan-300 cursor-pointer">Dossier →</a>
                </div>

                <div class="grid grid-cols-2 gap-3 text-xs font-mono select-none">
                    <div class="p-3 rounded bg-slate-950 border border-slate-800 select-none">
                        <span class="text-slate-500 text-[10px] block uppercase">BEST ACCURACY</span>
                        <span class="text-emerald-400 font-bold text-sm">
                            @(GameState.BestAccuracy > 0 ? $"{GameState.BestAccuracy}%" : "--")
                        </span>
                    </div>

                    <div class="p-3 rounded bg-slate-950 border border-slate-800 select-none">
                        <span class="text-slate-500 text-[10px] block uppercase">PEAK SPEED</span>
                        <span class="text-cyan-300 font-bold text-sm">
                            @(GameState.BestWpm > 0 ? $"{GameState.BestWpm} WPM" : "--")
                        </span>
                    </div>

                    <div class="p-3 rounded bg-slate-950 border border-slate-800 select-none">
                        <span class="text-slate-500 text-[10px] block uppercase">LONGEST RUN</span>
                        <span class="text-slate-200 font-bold text-sm">
                            @(GameState.LongestWaveRun > 0 ? $"Wave {GameState.LongestWaveRun}" : "--")
                        </span>
                    </div>

                    <div class="p-3 rounded bg-slate-950 border border-slate-800 select-none">
                        <span class="text-slate-500 text-[10px] block uppercase">HIGH SCORE</span>
                        <span class="text-amber-300 font-bold text-sm">
                            @(GameState.AllTimeHighScore > 0 ? GameState.AllTimeHighScore.ToString("N0") : "--")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Active Dictionary Preview Card -->
            <div class="rounded-xl bg-slate-900/60 border border-slate-800 p-6 space-y-3 select-none">
                <div class="flex items-center justify-between text-xs font-semibold text-slate-400 select-none">
                    <span class="text-slate-300 text-[11px] uppercase tracking-wider">Word Stream Preview</span>
                    <span class="text-cyan-400 text-[11px]">[@GameState.SelectedLexiconMode]</span>
                </div>
                <div class="flex flex-wrap gap-1.5 pt-1 select-none">
                    @foreach (var word in GameState.GetActiveDictionary().Take(12))
                    {
                        <span class="px-2 py-0.5 rounded bg-slate-950 text-slate-300 border border-slate-800 text-[11px] font-mono select-none">
                            @word
                        </span>
                    }
                    <span class="px-2 py-0.5 rounded bg-slate-950 text-slate-500 border border-slate-800 text-[11px] font-mono select-none">
                        +@(GameState.GetActiveDictionary().Count - 12) more
                    </span>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer Status -->
    <footer class="relative z-10 border-t border-slate-800/80 pt-4 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 select-none">
        <div>CyberType // Defense Grid // Standalone WebAssembly Game</div>
        <div class="flex gap-4 mt-2 sm:mt-0 select-none">
            <a href="profile" class="hover:text-cyan-400 transition-colors cursor-pointer">Operator Dossier</a>
            <span>•</span>
            <span class="text-slate-400">60 FPS Native Loop</span>
            <span>•</span>
            <span class="text-slate-400">Target Lock Engine</span>
        </div>
    </footer>
</div>

@code {
    private void SelectDifficulty(GameDifficulty diff)
    {
        GameState.SetDifficulty(diff);
    }

    private void SelectLexicon(LexiconMode mode)
    {
        GameState.SetLexiconMode(mode);
    }

    private void StartNewRun()
    {
        GameState.ResetRun();
        Navigation.NavigateTo("/defense-grid");
    }
}
