<div class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex flex-col items-center justify-center p-6 space-y-6 select-none font-mono">
    <div class="w-14 h-14 rounded-lg bg-red-950/40 border border-red-500/80 flex items-center justify-center text-red-400 text-2xl shadow-[0_0_20px_rgba(239,68,68,0.35)]">
        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
    </div>
    <div class="text-center space-y-1.5 select-none">
        <span class="text-[10px] uppercase tracking-widest text-red-500 font-bold">PERIMETER BREACHED // BASE DESTROYED</span>
        <h2 class="text-3xl font-extrabold text-white tracking-tight">DEFENSE GRID COMPROMISED</h2>
    </div>

    <div class="flex gap-4 select-none">
        <button @onclick="OnRestart"
                class="btn-tactical-primary cursor-pointer px-6 py-2.5 rounded text-xs tracking-wider uppercase transition-all">
            Restart Simulation
        </button>
        <button @onclick="OnReturnToBriefing"
                class="btn-tactical-outline cursor-pointer px-6 py-2.5 rounded text-xs tracking-wider uppercase transition-all">
            Return to Briefing
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnRestart { get; set; }
    [Parameter] public EventCallback OnReturnToBriefing { get; set; }
}
