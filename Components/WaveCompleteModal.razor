<div class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex flex-col items-center justify-center p-6 space-y-6 select-none animate-fade-in">
    <div class="w-14 h-14 rounded-lg bg-slate-900 border border-cyan-400 text-cyan-400 flex items-center justify-center text-2xl shadow-[0_0_20px_rgba(6,182,212,0.35)]">
        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
    </div>
    
    <div class="text-center space-y-1.5 select-none font-mono">
        <span class="text-[10px] uppercase tracking-widest text-cyan-400 font-bold">DEFENSE PERIMETER SECURED</span>
        <h2 class="text-3xl font-extrabold text-white tracking-tight">SECTOR @WaveNumber CLEARED</h2>
    </div>

    <div class="grid grid-cols-4 gap-4 w-full max-w-lg p-5 rounded-lg bg-slate-900/90 border border-slate-800 font-mono text-center select-none shadow-xl">
        <div>
            <div class="text-[10px] text-slate-500 uppercase tracking-wider">ACCURACY</div>
            <div class="text-base font-bold text-emerald-400 mt-1">@Accuracy%</div>
        </div>
        <div>
            <div class="text-[10px] text-slate-500 uppercase tracking-wider">SPEED</div>
            <div class="text-base font-bold text-cyan-400 mt-1">@Wpm WPM</div>
        </div>
        <div>
            <div class="text-[10px] text-slate-500 uppercase tracking-wider">WORDS</div>
            <div class="text-base font-bold text-slate-100 mt-1">@WordsCleared</div>
        </div>
        <div>
            <div class="text-[10px] text-slate-500 uppercase tracking-wider">MAX COMBO</div>
            <div class="text-base font-bold text-amber-400 mt-1">@(MaxCombo)x</div>
        </div>
    </div>

    <!-- Proceed to Upgrade Hub Button -->
    <button @onclick="OnProceed"
            class="btn-tactical-primary cursor-pointer px-8 py-3.5 rounded text-xs tracking-widest uppercase flex items-center justify-center gap-2 select-none">
        <span>PROCEED TO UPGRADE BAY</span>
        <span>→</span>
    </button>
</div>

@code {
    [Parameter] public int WaveNumber { get; set; }
    [Parameter] public double Accuracy { get; set; }
    [Parameter] public int Wpm { get; set; }
    [Parameter] public int WordsCleared { get; set; }
    [Parameter] public int MaxCombo { get; set; }
    [Parameter] public EventCallback OnProceed { get; set; }
}
